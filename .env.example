# Sao chép file này thành .env rồi điền giá trị thật. KHÔNG commit file .env.

# Chuỗi bí mật để ký JWT (đổi thành chuỗi ngẫu nhiên dài khi triển khai)
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CSDL: SQLite cho demo. Có thể đổi sang PostgreSQL/MySQL, ví dụ:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/sales
DATABASE_URL=sqlite:///./data/sales.db

# Gemini API - lấy key tại https://aistudio.google.com/apikey
# Để trống GEMINI_API_KEY => hệ thống chạy chế độ AI dự phòng (rule-based), vẫn demo được.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Model dự phòng (cách nhau bởi dấu phẩy): gói miễn phí giới hạn lượt gọi MỖI MODEL mỗi ngày,
# khi model chính hết lượt / quá tải hệ thống tự chuyển sang model kế tiếp. Để trống = không dùng.
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash,gemini-3.5-flash-lite
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
# Mức suy nghĩ của AI trước khi trả lời: minimal (nhanh nhất) | low | medium | high (chậm, kỹ nhất)
AI_THINKING_LEVEL=minimal

# Thông tin cửa hàng in trên hóa đơn
SHOP_NAME=Cửa hàng TechStoreAI

# Tài khoản nhận chuyển khoản, dùng để tạo mã VietQR khi khách thanh toán bằng chuyển khoản.
# VIETQR_BANK_BIN: mã BIN ngân hàng (Vietcombank 970436, Techcombank 970407, MB 970422,
# BIDV 970418, VietinBank 970415, ACB 970416...). Danh sách đầy đủ: https://api.vietqr.io/v2/banks
# Giá trị mặc định dưới đây là tài khoản DEMO, cần đổi thành tài khoản thật.
VIETQR_BANK_BIN=970436
VIETQR_BANK_NAME=Vietcombank
VIETQR_ACCOUNT_NO=0123456789
VIETQR_ACCOUNT_NAME=CUA HANG TECHSTOREAI

# Phiên bản prompt tư vấn đang dùng (v1, v2, v3)
ADVISOR_PROMPT_VERSION=v3

# Quản trị viên quên mật khẩu: mã xác nhận 6 số gửi tới ADMIN_EMAIL. Chọn MỘT cách gửi email:
#  - Resend (bắt buộc nếu deploy Render gói miễn phí, vì Render chặn cổng SMTP): đăng ký https://resend.com
#    bằng CHÍNH địa chỉ ADMIN_EMAIL (chưa xác minh tên miền thì Resend chỉ gửi tới email chủ tài khoản),
#    tạo API key rồi điền RESEND_API_KEY.
#  - Gmail SMTP (chạy trên máy): bật Xác minh 2 bước cho Gmail, tạo mật khẩu ứng dụng tại
#    https://myaccount.google.com/apppasswords, điền SMTP_USER = địa chỉ Gmail, SMTP_PASSWORD = mật khẩu ứng dụng.
# Có RESEND_API_KEY thì dùng Resend, ngược lại dùng SMTP.
ADMIN_EMAIL=
RESEND_API_KEY=
SMTP_USER=
SMTP_PASSWORD=
RESET_CODE_MINUTES=10
